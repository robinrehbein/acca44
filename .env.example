# Local development only: copy to .env and replace every password placeholder.
# Coolify generates these SERVICE_* passwords itself; do not upload your local .env.
POSTGRES_DB=acca44
POSTGRES_USER=acca44
SUPERADMIN_USERNAME=admin@acca44.example
SERVICE_PASSWORD_64_POSTGRES=replace-with-random-local-database-password
SERVICE_PASSWORD_64_COOKIE=replace-with-random-local-cookie-secret
SERVICE_PASSWORD_64_ADMIN=replace-with-random-local-administrator-password
SERVICE_PASSWORD_64_OPERATOR=replace-with-random-local-operator-password
SERVICE_URL_SERVER_3001=http://localhost:3001
SERVICE_URL_STOREFRONT_3000=http://localhost:3000
# Local HTTP only. Coolify HTTPS deployment defaults to true when omitted.
COOKIE_SECURE=false
